# Dependencies
node_modules/
frontend/node_modules/

# Build outputs (except docs/ which is GitHub Pages)
frontend/dist/
frontend/.vite/

# Logs
*.log
frontend/npm_dev.log

# Lock files (optional: remove if you want to commit these)
frontend/package-lock.json

# Environment / secrets
.env
.env.*

# Session cookies (never commit)
scripts/tiktok_cookies.json
scripts/x_cookies.json

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
scripts/__pycache__/

# Editor
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude project data
.claude/

# Misc
commit_message.txt
tree.txt
output.log
output/
out/
gemini_work/
tmp/
test_*.png
test_*.mp4

# SNS videos (source files in frontend/public — only docs/sns_videos/ is committed)
frontend/public/sns_videos/
backend/scripts/*.mp4

# Temp WebM files from video generation
*.webm

# Script logs
scripts/logs/
scripts/x_post_state.json
